
# Environment variables (contains API keys - NEVER commit this!)
.env

# Python virtual environment
venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# Application data (generated at runtime)
data/
logs/

# SSL certs (generated by tools/gen_cert.py)
cert/

# Embedding model (auto-downloaded, ~120MB)
AImodels/

# Kilo agent data
.kilo/

# Backup
backup_*/

# IDE
.vscode/
.idea/

# OS
Thumbs.db
.DS_Store

# Temp files
*.tmp
